{
  "expo": {
    "name": "Re:Read",
    "slug": "reread",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "reread",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.vivacegames.reread",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/re-read-foreground.png",
        "monochromeImage": "./assets/icons/re-read-monochrome.png",
        "backgroundColor": "#3A5A73"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vivacegames.reread"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/re-read-notification.png",
          "color": "#3A5A73"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icons/icon.png"
  }
}
